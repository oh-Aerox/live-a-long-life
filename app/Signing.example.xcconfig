// 本机签名配置示例。复制为同目录的 Signing.xcconfig 后填入自己的值：
//   cp Signing.example.xcconfig Signing.xcconfig
// Signing.xcconfig 不进 git，iOS 与 macOS 工程都会读取它；没有这个文件时
// 使用下面这些默认值（只能在模拟器或本机构建，无法装到真机）。

// Apple 开发者 team ID（Xcode → Settings → Accounts 里能看到，免费账号也有）。
DEVELOPMENT_TEAM =

// 应用的 bundle ID。免费账号需要一个全局唯一、属于你自己的 ID，
// 开发期间保持不变：换了 ID 就是另一个应用，原来的数据不会跟过去。
APP_BUNDLE_ID = com.example.livealonglife

// 只给 scripts/resign-install.sh 用：默认安装到哪台 iPhone（xcrun devicectl list devices 查看）。
IOS_DEVICE_ID =
